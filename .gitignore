# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
# Build output — GitHub Actions rebuilds this from source on every
# push (see .github/workflows/deploy.yml), so it is never committed.
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Finder litter — public/ is now site content, so keep these out of it
**/.DS_Store

# Processing?
applet
application.linux32
application.linux64
application.windows32
application.windows64
application.macosx

# Data inputs
civxml_to_json/*.json
civxml_to_json/*.xml
civxml_to_json/XML/*
civxml_to_json/civ4/*
civxml_to_json/war/*
civxml_to_json/bts/*

# Raw game asset dumps for the scrapers — kept locally, never committed.
# Only the Python scripts under data_scrapers/<game>/ are tracked.
data_scrapers/*/data/
data_scrapers/**/__pycache__/
